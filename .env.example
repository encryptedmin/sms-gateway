# Redis connection used by Celery, SMS recipient locks, and modem checks.
#
# The defaults below match compose.yaml. Change REDIS_PORT if 6379 is already
# occupied. REDIS_URL may be set instead when using a remote/authenticated
# Redis service, for example: redis://user:password@host:6380/0
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DB=0

# Optional independent Celery overrides:
# CELERY_BROKER_URL=redis://127.0.0.1:6379/0
# CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/0

# Branded local site. Vite serves this on port 80 and proxies /api to Django.
SMS_SITE_HOST=sms.ite
SMS_SITE_PORT=80
DJANGO_DEV_URL=http://127.0.0.1:8000

# Optional comma-separated overrides:
# DJANGO_ALLOWED_HOSTS=sms.ite,127.0.0.1,localhost
# CORS_ALLOWED_ORIGINS=http://sms.ite
# CSRF_TRUSTED_ORIGINS=http://sms.ite

# Seconds allowed for a normal page reload before a last-tab close is treated
# as a closed browser session.
BROWSER_SESSION_CLOSE_GRACE_SECONDS=2
